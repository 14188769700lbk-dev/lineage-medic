{
  "name": "lineage-medic",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "An agentic repair campaign for breaking data changes, grounded in DataHub context.",
  "license": "Apache-2.0",
  "scripts": {
    "demo": "tsx src/cli.ts",
    "dev": "concurrently -k -n API,WEB -c cyan,magenta \"npm:dev:server\" \"npm:dev:web\"",
    "dev:server": "tsx watch src/server/index.ts",
    "dev:web": "vite --host 127.0.0.1",
    "build": "npm run typecheck && vite build && tsup src/server/index.ts --format esm --platform node --out-dir dist-server --clean",
    "start": "node dist-server/index.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "verify": "npm run typecheck && npm test && npm run build"
  },
  "dependencies": {
    "@fastify/cors": "latest",
    "@fastify/static": "latest",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "fastify": "latest",
    "lucide-react": "latest",
    "node-sql-parser": "^5.4.0",
    "react": "latest",
    "react-dom": "latest",
    "yaml": "^2.9.0",
    "zod": "latest"
  },
  "devDependencies": {
    "@types/node": "latest",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "@vitejs/plugin-react": "latest",
    "concurrently": "latest",
    "tsup": "latest",
    "tsx": "latest",
    "typescript": "latest",
    "vite": "latest",
    "vitest": "latest"
  }
}
