# Fixture mode works without credentials and is what the public demo uses.
LINEAGE_MEDIC_MODE=fixture

# Live DataHub Cloud MCP (set LINEAGE_MEDIC_MODE=mcp-http).
DATAHUB_MCP_URL=
DATAHUB_MCP_TOKEN=

# Self-hosted DataHub MCP over stdio (set LINEAGE_MEDIC_MODE=mcp-stdio).
# Default command is: uvx mcp-server-datahub@latest
DATAHUB_MCP_COMMAND=uvx
DATAHUB_GMS_URL=http://localhost:8080
DATAHUB_GMS_TOKEN=

# Optional GitHub integration for opening draft repair PRs.
GITHUB_TOKEN=
GITHUB_OWNER=

# Optional model provider for non-deterministic patch suggestions.
OPENAI_API_KEY=
